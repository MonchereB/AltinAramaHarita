<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Baslik -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/menu_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/colorPrimaryDark"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/menu_subtitle"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:paddingHorizontal="24dp"
        android:paddingBottom="8dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"/>

    <!-- Surum guncelleme -->
    <LinearLayout
        android:id="@+id/menuUpdate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?android:attr/selectableItemBackground"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_popup_sync"
            android:contentDescription="@string/menu_update"
            android:tint="@color/colorPrimaryDark"/>

        <TextView
            android:id="@+id/menuUpdateText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:text="@string/menu_update"
            android:textSize="16sp"
            android:textColor="@color/text_primary"/>

        <TextView
            android:id="@+id/menuUpdateBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YENİ"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#C62828"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Yasal uyari -->
    <LinearLayout
        android:id="@+id/menuLegal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?android:attr/selectableItemBackground"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_dialog_alert"
            android:contentDescription="@string/menu_legal"
            android:tint="#B71C1C"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:text="@string/menu_legal"
            android:textSize="16sp"
            android:textColor="@color/text_primary"/>
    </LinearLayout>

    <!-- Cevrimdisi harita bilgisi -->
    <LinearLayout
        android:id="@+id/menuOfflineInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?android:attr/selectableItemBackground"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_mapmode"
            android:contentDescription="@string/menu_offline"
            android:tint="#2E7D32"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:text="@string/menu_offline"
            android:textSize="16sp"
            android:textColor="@color/text_primary"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"/>

    <!-- En altta surum numarasi -->
    <TextView
        android:id="@+id/menuVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingTop="14dp"
        android:paddingBottom="6dp"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:text="v1.0.0"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingBottom="16dp"
        android:textSize="11sp"
        android:textColor="#9E9E9E"
        android:text="@string/menu_version_note"/>

</LinearLayout>
