<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Harita Görünümü (OSMDroid) -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Menü (üç çizgi) butonu - sağ üst köşe -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:contentDescription="@string/menu_open"
        android:src="@drawable/ic_more_vert"
        app:backgroundTint="@color/colorPrimary"
        app:tint="@android:color/white"
        app:elevation="8dp"
        app:fabSize="mini"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Konum butonu - menünün altında -->
    <Button
        android:id="@+id/btnCenterMyLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_center"
        android:textColor="#FFFFFF"
        android:backgroundTint="@color/colorPrimary"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="62dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="6dp"/>

    <!-- Katman bilgisi - sağ alt -->
    <TextView
        android:id="@+id/tvLayerInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/layer_gold"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:background="#D9FFFFFF"
        android:padding="6dp"
        android:elevation="4dp"
        android:layout_margin="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
