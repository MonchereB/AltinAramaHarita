<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Harita Görünümü (OSMDroid) -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Menü (üç çizgi) butonu - sağ üst köşe -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:contentDescription="@string/menu_open"
        android:src="@drawable/ic_more_vert"
        app:backgroundTint="@color/colorPrimary"
        app:tint="@android:color/white"
        app:elevation="8dp"
        app:fabSize="mini"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Konum butonu - menünün altında (yuvarlak mini FAB, standart konum ikonu) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnCenterMyLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:contentDescription="@string/btn_center"
        android:src="@drawable/ic_my_location"
        app:backgroundTint="@color/colorPrimary"
        app:tint="@android:color/white"
        app:elevation="8dp"
        app:fabSize="mini"
        app:layout_constraintTop_toBottomOf="@id/btnMenu"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TOPO / UYDU geçişi - sol alt -->
    <LinearLayout
        android:id="@+id/mapStyleToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:elevation="4dp"
        android:layout_margin="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/chipTopo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/style_topo"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_toggle"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:elevation="6dp"
            android:clickable="true"
            android:focusable="true"/>

        <Space
            android:layout_width="4dp"
            android:layout_height="1dp"/>

        <TextView
            android:id="@+id/chipSat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/style_sat"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_toggle"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:elevation="6dp"
            android:clickable="true"
            android:focusable="true"/>

        <Space
            android:layout_width="4dp"
            android:layout_height="1dp"/>

        <TextView
            android:id="@+id/chipLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/style_live"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_toggle"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:elevation="6dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- Katman bilgisi - sağ alt köşede küçük etiket (çiplerin üstünde) -->
    <TextView
        android:id="@+id/tvLayerInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/layer_gold"
        android:textColor="#8A000000"
        android:textSize="10sp"
        android:background="#B3FFFFFF"
        android:paddingHorizontal="5dp"
        android:paddingVertical="2dp"
        android:elevation="4dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toTopOf="@id/mapStyleToggle"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
