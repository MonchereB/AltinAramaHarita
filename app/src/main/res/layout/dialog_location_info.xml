<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="560dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/colorPrimaryDark"
            android:layout_marginBottom="4dp"/>

        <!-- Guven rozeti -->
        <TextView
            android:id="@+id/dialog_confidence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#B8860B"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/dialog_coords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="3dp"/>

        <TextView
            android:id="@+id/dialog_elevation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="3dp"/>

        <TextView
            android:id="@+id/dialog_terrain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="3dp"/>

        <TextView
            android:id="@+id/dialog_distance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginVertical="6dp"/>

        <!-- Jeolojik bilgi bloklari -->
        <TextView
            android:id="@+id/dialog_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/dialog_lithology"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/dialog_indicators"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/dialog_reasoning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginVertical="6dp"/>

        <TextView
            android:id="@+id/dialog_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/dialog_btn_open_maps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dialog_open_maps"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/colorAccent"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/dialog_btn_center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dialog_center_map"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/colorPrimary"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/dialog_btn_close"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dialog_close"
            android:textColor="#FFFFFF"
            android:backgroundTint="#9E9E9E"/>

    </LinearLayout>
</ScrollView>
